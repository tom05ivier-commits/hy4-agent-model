{
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "mcp-server-filesystem",
        "/root/workspace"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "mcp-server-sequential-thinking"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--config",
        "/usr/share/opencode/playwright-mcp.json"
      ],
      "enabled": true
    },
    "servers": {
      "new-mcp-server": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/mcp_github_token.txt}"
        },
        "oauth": false,
        "disabled": false
      },
      "memory": {
        "type": "local",
        "command": [
          "mcp-server-memory"
        ],
        "disabled": false
      },
      "everything": {
        "type": "local",
        "command": [
          "mcp-server-everything"
        ],
        "disabled": false
      },
      "github": {
        "type": "local",
        "command": [
          "mcp-server-github"
        ],
        "disabled": false,
        "protocol": "auto"
      },
      "bigquery": {
        "type": "remote",
        "url": "https://bigquery.googleapis.com/mcp",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/bigquery_token.txt}",
          "accept": "application/json, text/event-stream"
        },
        "oauth": false,
        "disabled": true
      }
    }
  },
  "plugins": [
    "@openchamber/opencode-claude@1.7.0",
    {
      "package": "/root/.config/opencode/plugins/device-control",
      "options": {}
    }
  ],
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.json",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*.jsonc",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*.toml",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "/root/.config/opencode/opencode.*",
      "effect": "ask"
    },
    {
      "action": "device",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python3 /root/.config/opencode/skills/android-device/android_device.py *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "opencode api *",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://opencode.ai/v2/openapi.json",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://opencode.ai/docs/openapi.json",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "http://localhost:*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "http://127.0.0.1:*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/root/infinity/docs/opencode-openapi-v2.json",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "openssl req *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "openssl x509 *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git fetch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh auth login *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh repo *",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "http://127.0.0.1:*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "http://127.0.0.1:8785/*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://127.0.0.1:*",
      "effect": "deny"
    }
  ],
  "websearch": {
    "provider": "random"
  },
